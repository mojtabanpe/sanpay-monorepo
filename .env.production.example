# این فایل را روی سرور با نام .env.production کپی کنید و تمام رازها را تغییر دهید.
POSTGRES_USER=sanpay
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=sanpay

JWT_SECRET=CHANGE_ME_WITH_OPENSSL_RAND_HEX_32
OTP_SECRET=CHANGE_ME_WITH_ANOTHER_OPENSSL_RAND_HEX_32

# فقط reverse proxy همان سرور به gateway دسترسی دارد.
GATEWAY_BIND=127.0.0.1
HTTP_PORT=8080

SMS_MODE=smsir
