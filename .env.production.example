TOMAN_HOTELYAR_IBAN=
TOMAN_HOTELYAR_NAME=هتل‌یار
TOMAN_EGHAMAT24_IBAN=
TOMAN_EGHAMAT24_NAME=اقامت۲۴

GRS_MODE=mock
