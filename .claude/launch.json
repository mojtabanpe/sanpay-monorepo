{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["nx", "serve", "app"],
      "port": 6200
    },
    {
      "name": "dashboard",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["nx", "serve", "dashboard"],
      "port": 6300
    },
    {
      "name": "store",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["nx", "serve", "store"],
      "port": 6400
    },
    {
      "name": "api",
      "runtimeExecutable": "env",
      "runtimeArgs": ["SMS_MODE=console", "pnpm", "nx", "serve", "api"],
      "port": 6500
    },
    {
      "name": "api-upg-toman-mock",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "SMS_MODE=console",
        "UPG_GATEWAYS=toman",
        "TOMAN_IPG_MODE=mock",
        "pnpm",
        "nx",
        "serve",
        "api"
      ],
      "port": 6500
    }
  ]
}
