{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "webpack-cli build",
        "env": {
          "NODE_ENV": "production"
        },
        "cwd": "apps/api"
      },
      "configurations": {
        "development": {
          "env": {
            "NODE_ENV": "development"
          }
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": [
        "build"
      ],
      "options": {
        "buildTarget": "api:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "api:build:development"
        },
        "production": {
          "buildTarget": "api:build:production"
        }
      }
    },
    "test-flights": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -r @swc-node/register --test apps/api/tests/flights.test.ts",
        "env": {
          "SWC_NODE_PROJECT": "apps/api/tsconfig.test.json"
        }
      }
    },
    "test-flights-integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -r @swc-node/register --test apps/api/tests/flights.integration.test.ts",
        "env": {
          "SWC_NODE_PROJECT": "apps/api/tsconfig.test.json"
        }
      }
    },
    "test-eghamat24": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -r @swc-node/register --test apps/api/tests/eghamat24.test.ts",
        "env": {
          "SWC_NODE_PROJECT": "apps/api/tsconfig.test.json"
        }
      }
    },
    "test-toman": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -r @swc-node/register --test apps/api/tests/toman-client.test.ts",
        "env": {
          "SWC_NODE_PROJECT": "apps/api/tsconfig.test.json"
        }
      }
    },
    "test-toman-ipg": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -r @swc-node/register --test apps/api/tests/toman-ipg.test.ts",
        "env": {
          "SWC_NODE_PROJECT": "apps/api/tsconfig.test.json"
        }
      }
    },
    "check-toman-ipg": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -r @swc-node/register apps/api/scripts/toman-ipg-check.ts",
        "env": {
          "SWC_NODE_PROJECT": "apps/api/tsconfig.app.json"
        }
      }
    },
    "eghamat24-scenarios": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -r @swc-node/register apps/api/scripts/eghamat24-scenarios.ts",
        "env": {
          "SWC_NODE_PROJECT": "apps/api/tsconfig.app.json"
        }
      }
