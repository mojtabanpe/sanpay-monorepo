generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─── شرکت و ردهٔ سازمانی ─────────────────────────────────────────────────────────────

model Company {
  logoUrl   String?
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees         Employee[]
  walletDefinitions WalletDefinition[]
}

enum OrganizationalRank {
  /// مدیر
  MANAGER
  /// معاون
  DEPUTY
  /// رییس
  HEAD
  /// کارمند
  EMPLOYEE
}

// ─── کارمند ───────────────────────────────────────────────────────────────────

model Employee {
  id                 String             @id @default(uuid())
  /// کد ملی — شناسهٔ ورود به سامانه
  nationalCode       String
  birthDate          DateTime?          @db.Date
  deletedAt          DateTime?
  personnelCode      String
  firstName          String
  lastName           String
  /// هر استخدام حساب مستقلی با شماره موبایل یکتا دارد.
  phone              String?            @unique
  companyId          String
  organizationalRank OrganizationalRank
  /// تا پیش از اولین ورود با OTP خالی است
  passwordHash       String?
  /// نام فایل عکس پروفایل در `UPLOADS_DIR/avatars` (تصادفی، نه کد ملی) —
  /// خالی یعنی بدون عکس؛ اپ حروف اول نام را نشان می‌دهد
  avatarFile         String?
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  company                Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  allocations            WalletAllocation[]
  purchaseCodes          PurchaseCode[]
  transactions           Transaction[]
  payments               Payment[]
  hotelBookings          HotelBooking[]
  flightBookings         FlightBooking[]
  merchantPaymentIntents MerchantPaymentIntent[]
  paymentIntents         PaymentIntent[]
  gatewayPayments        GatewayPayment[]
  gatewayRefunds         GatewayRefund[]
  otp                    EmployeeOtp?

  @@unique([companyId, nationalCode])
  @@unique([companyId, personnelCode])
  @@index([companyId])
  @@index([nationalCode])
}

/// آخرین کد ورود کارمند؛ کد خام هرگز ذخیره نمی‌شود.
model EmployeeOtp {
  id         String   @id @default(uuid())
  employeeId String   @unique
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  sentAt     DateTime @default(now())
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

// ─── کیف پول ──────────────────────────────────────────────────────────────────

enum WalletKind {
  /// اعتبار خرید عادی
  CREDIT
  /// سهمیهٔ ارزاق
  RATION
  /// اعتبار گردشگری — برای رزرو هتل و پرواز، نه فروشگاه‌ها
  TOURISM
  /// کیف پول شخصی (پنهان): مبلغی که کارمند در UPG با کارت پرداخت کرده، همان
  /// لحظه به این کیف پول واریز و در خرید برداشت می‌شود. به کاربر نمایش داده
  /// نمی‌شود و از همهٔ فهرست‌ها و گزارش‌های اعتبار رفاهی کنار گذاشته می‌شود.
  PERSONAL
}

/// تعریف مشترک یک کیف پول (مثلاً «ارزاق ماهانه») که به فروشگاه‌های مشخصی وصل است.
/// اعتبار هر کارمند از این تعریف، در WalletAllocation با سقف و انقضای خودش نگهداری می‌شود.
model WalletDefinition {
  id          String     @id @default(uuid())
  companyId   String
  name        String
  kind        WalletKind @default(CREDIT)
  description String?
  /// اسلاگ آیکون برای نمایش در اپ (food | grocery | sport | health | …)
  imageUrl    String?
  icon        String?
  /// سقف پیش‌فرض تخصیص‌ها (تومان) — قابل بازنویسی به‌ازای هر کارمند
  defaultCap  BigInt?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  company     Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  stores      WalletDefinitionStore[]
  allocations WalletAllocation[]

  @@index([companyId])
}

/// تخصیص یک کیف پول به یک کارمند: سقف اعتبار، مصرف‌شده و تاریخ انقضا.
/// مانده = cap - spent
model WalletAllocation {
  id           String   @id @default(uuid())
  employeeId   String
  definitionId String
  /// سقف اعتبار (تومان)
  cap          BigInt
  /// جمع مصرف‌شده (تومان) — دینرمالایز از تراکنش‌ها
  spent        BigInt   @default(0)
  expiresAt    DateTime
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee       Employee         @relation(fields: [employeeId], references: [id])
  definition     WalletDefinition @relation(fields: [definitionId], references: [id])
  purchaseCodes  PurchaseCode[]
  transactions   Transaction[]
  hotelBookings  HotelBooking[]
  flightBookings FlightBooking[]

  @@index([employeeId])
  @@index([definitionId])
}

// ─── فروشگاه ──────────────────────────────────────────────────────────────────

model Store {
  id                  String    @id @default(uuid())
  name                String
  /// کد کوتاه فروشگاه — محتوای QR ثابتِ چاپ‌شده روی صندوق و قابل تایپ دستی
  code                String    @unique
  /// دسته‌بندی (آجیل، میوه، پروتئین، عینک، …)
  category            String?
  phone               String?
  address             String?
  deletedAt           DateTime?
  logoUrl             String?
  latitude            Decimal?  @db.Decimal(9, 6)
  longitude           Decimal?  @db.Decimal(9, 6)
  /// شبای مقصد تسویهٔ شبانه در تومان
  settlementIban      String?
  /// نام صاحب حساب برای ثبت در آیتم انتقال
  settlementOwnerName String?
  /// ورود پنل فروشگاه
  username            String    @unique
  passwordHash        String
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  walletDefinitions      WalletDefinitionStore[]
  transactions           Transaction[]
  payments               Payment[]
  settlementItems        SettlementItem[]
  merchantPaymentIntents MerchantPaymentIntent[]
  paymentIntents         PaymentIntent[]
}

/// رابطهٔ چند-به-چند: هر کیف پول در کدام فروشگاه‌ها قابل استفاده است
model WalletDefinitionStore {
  definitionId String
  storeId      String

  definition WalletDefinition @relation(fields: [definitionId], references: [id])
  store      Store            @relation(fields: [storeId], references: [id])

  @@id([definitionId, storeId])
}

// ─── خرید با کد یک‌بارمصرف ────────────────────────────────────────────────────

enum PurchaseCodeStatus {
  PENDING
  USED
  EXPIRED
  CANCELED
}

/// کد QR یک‌بارمصرف که کارمند می‌سازد و فروشنده اسکن می‌کند (اعتبار ~۱ دقیقه)
model PurchaseCode {
  id           String             @id @default(uuid())
  code         String             @unique
  employeeId   String
  allocationId String
  status       PurchaseCodeStatus @default(PENDING)
  expiresAt    DateTime
  createdAt    DateTime           @default(now())

  employee    Employee         @relation(fields: [employeeId], references: [id])
  allocation  WalletAllocation @relation(fields: [allocationId], references: [id])
  transaction Transaction?

  @@index([employeeId, status])
}

// ─── پرداخت ───────────────────────────────────────────────────────────────────

/// یک پرداخت در صندوق فروشگاه: کارمند QR ثابت فروشگاه را اسکن می‌کند، مبلغ را
/// وارد می‌کند و مبلغ می‌تواند بین چند کیف پول شکسته شود. هر سطر یک Transaction است.
model Payment {
  id               String    @id @default(uuid())
  /// شمارهٔ رسید — چیزی که کارمند به فروشنده نشان می‌دهد و در پنل فروشگاه دیده می‌شود
  receiptNo        String    @unique
  employeeId       String
  storeId          String
  /// جمع کل پرداخت (تومان)
  amount           BigInt
  settlementItemId String?
  settledAt        DateTime?
  merchantIntentId String?   @unique
  /// درخواست پرداخت UPG که این خرید را پرداخت کرده
  intentId         String?   @unique
  createdAt        DateTime  @default(now())

  employee       Employee               @relation(fields: [employeeId], references: [id])
  intent         PaymentIntent?         @relation(fields: [intentId], references: [id], onDelete: Restrict)
  store          Store                  @relation(fields: [storeId], references: [id])
  transactions   Transaction[]
  settlementItem SettlementItem?        @relation(fields: [settlementItemId], references: [id], onDelete: Restrict)
  merchantIntent MerchantPaymentIntent? @relation(fields: [merchantIntentId], references: [id], onDelete: Restrict)

  @@index([storeId, createdAt])
  @@index([employeeId, createdAt])
  @@index([settlementItemId])
}

enum MerchantPaymentIntentStatus {
  PENDING
  USED
  EXPIRED
  CANCELED
}

/// پرداختی که فروشگاه با کد ملی، موبایل و مبلغ آغاز می‌کند و مشتری با OTP تأیید می‌کند.
model MerchantPaymentIntent {
  id             String                      @id @default(uuid())
  storeId        String
  employeeId     String
  amount         BigInt
  codeHash       String
  attempts       Int                         @default(0)
  status         MerchantPaymentIntentStatus @default(PENDING)
  expiresAt      DateTime
  sentAt         DateTime                    @default(now())
  idempotencyKey String?                     @unique
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  store     Store          @relation(fields: [storeId], references: [id], onDelete: Restrict)
  employee  Employee       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  payment   Payment?
  /// اگر اعتبار کافی نبود، باقی مبلغ را کارمند از این درخواست UPG با کارت می‌پردازد
  upgIntent PaymentIntent?

  @@index([storeId, createdAt])
  @@index([employeeId, status, expiresAt])
}

// ─── رزرو هتل (گردشگری) ───────────────────────────────────────────────────────

enum BookingStatus {
  /// منتظر پرداخت در UPG — هنوز سراغ تأمین‌کننده نرفته‌ایم
  AWAITING_PAYMENT
  /// رزرو قطعی است
  CONFIRMED
  /// اتاق نگه داشته شده و منتظر نهایی‌سازی ماست (اقامت۲۴؛ holdExpiresAt دارد)
  HOLD
  /// ظرفیت آفلاین — تأمین‌کننده بعداً از طریق webhook تأیید یا رد می‌کند
  PENDING
  /// کنسلی درخواست شده و جریمه‌اش اعلام شده، منتظر تأیید کارمند
  CANCELING
  /// تغییر درخواست شده و هزینه‌اش اعلام شده، منتظر تأیید کارمند
  MODIFYING
  REJECTED
  CANCELED
}

/// تأمین‌کنندهٔ هتل. مقدارها همان پیشوند شناسه‌های مبهم‌اند (`hy:…` / `eg:…`).
enum HotelProviderKey {
  /// هتل‌یار / WorldGDS — همهٔ شهرها به‌جز مشهد
  hy
  /// اقامت۲۴ / GRS — مشهد
  eg
}

/// رزرو هتل با اعتبار گردشگری. هتل‌ها فروشگاه نیستند: رزرو مستقیماً روی API
/// تأمین‌کننده انجام می‌شود و فقط در صورت موفقیت، اعتبار کارمند کم می‌شود.
/// تسویهٔ ریالی با هتل‌یار جداگانه و شبانه انجام می‌شود (settledAt).
model HotelBooking {
  id                String           @id @default(uuid())
  /// شمارهٔ پیگیری داخلی — همان کد پیگیری که به تأمین‌کننده فرستاده می‌شود
  referenceNo       String           @unique
  /// کدام تأمین‌کننده این رزرو را دارد
  provider          HotelProviderKey
  /// شناسهٔ رزرو نزد تأمین‌کننده — با آن confirm/cancel می‌زنیم و webhook را تطبیق می‌دهیم
  providerReserveId String?
  status            BookingStatus    @default(PENDING)
  /// مهلت نهایی‌سازی در وضعیت HOLD
  holdExpiresAt     DateTime?

  employeeId    String
  /// کیف پول رزروهای قبل از UPG — رزروهای جدید از `intentId` پرداخت می‌شوند
  allocationId  String?
  /// تراکنش کسر اعتبار رزروهای قبل از UPG
  transactionId String? @unique
  /// درخواست پرداخت UPG — پول این رزرو (از هر منبعی) زیر این intent است
  intentId      String? @unique

  /// شناسهٔ مبهم هتل («eg:740») — provider داخلش کدگذاری شده
  hotelId        String
  hotelName      String
  /// شناسهٔ مبهم اتاق («eg:740:12:5») — برای اقامت۲۴ شامل نرخ‌نامه هم هست
  roomId         String
  roomType       String
  checkin        DateTime
  nights         Int
  guestName      String
  guestIdNo      String
  /// فیلدهای تفکیک‌شده برای انتخاب دوبارهٔ مسافر در رزروهای بعدی
  guestFirstName String?
  guestLastName  String?
  guestMobile    String?
  /// مبلغ کسرشده از کیف پول (تومان)
  amount         BigInt
  /// مبلغی که باید به تأمین‌کننده پرداخت شود (تومان) — مبنای تسویهٔ شبانه
  payable        BigInt

  /// زمان تسویه با تأمین‌کننده از طریق پرداخت‌یار (null = تسویه‌نشده)
  settledAt         DateTime?
  /// شناسهٔ دستهٔ تسویهٔ شبانه
  settlementBatchId String?
  settlementItemId  String?

  /// زمان رد/کنسل‌شدن از سمت تأمین‌کننده (از طریق webhook یا درخواست خودمان)
  canceledAt      DateTime?
  /// مبلغی که بابت رد یا کنسلی به کیف پول برگشت (تومان)
  refundedAmount  BigInt?
  /// جریمهٔ کنسلیِ اعلام‌شده در وضعیت CANCELING (تومان) — نزد تأمین‌کننده می‌ماند
  cancellationFee BigInt?
  /// توضیح تأمین‌کننده دربارهٔ رد یا تغییر رزرو — در اپ به کارمند نشان داده می‌شود
  statusNote      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee       Employee          @relation(fields: [employeeId], references: [id])
  allocation     WalletAllocation? @relation(fields: [allocationId], references: [id], onDelete: Restrict)
  transaction    Transaction?      @relation(fields: [transactionId], references: [id])
  intent         PaymentIntent?    @relation(fields: [intentId], references: [id], onDelete: Restrict)
  webhookEvents  GdsWebhookEvent[]
  settlementItem SettlementItem?   @relation(fields: [settlementItemId], references: [id], onDelete: Restrict)

  @@index([employeeId, createdAt])
  @@index([settledAt])
  @@index([provider, providerReserveId])
  @@index([settlementItemId])
}

// ─── تسویهٔ شبانه با بانکداری شرکتی تومان ────────────────────────────────────

enum SettlementBatchStatus {
  BUILDING
  SUBMITTED
  PROCESSING
  COMPLETED
  PARTIAL_FAILED
  FAILED
}

enum SettlementItemStatus {
  CREATED
  SUBMITTED
  PROCESSING
  SUCCEEDED
  FAILED
  UNKNOWN
}

enum SettlementBeneficiaryType {
  STORE
  HOTELYAR
  EGHAMAT24
}

/// یک اجرای روزانه؛ runKey بر اساس تاریخ تهران است و اجرای تکراری cron را بی‌اثر می‌کند.
model SettlementBatch {
  id             String                @id @default(uuid())
  runKey         String                @unique
  status         SettlementBatchStatus @default(BUILDING)
  tomanBatchUuid String?               @unique
  totalAmount    BigInt                @default(0)
  itemCount      Int                   @default(0)
  error          String?
  submittedAt    DateTime?
  completedAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  items SettlementItem[]

  @@index([status, createdAt])
}

/// هر ذی‌نفع دقیقاً یک انتقال تجمیعی دارد؛ خریدهای مبنا به این سطر متصل‌اند.
model SettlementItem {
  id                String                    @id @default(uuid())
  batchId           String
  beneficiaryType   SettlementBeneficiaryType
  beneficiaryKey    String
  storeId           String?
  beneficiaryName   String
  destinationIban   String
  amount            BigInt
  trackerId         String                    @unique
  status            SettlementItemStatus      @default(CREATED)
  tomanItemUuid     String?                   @unique
  tomanTransferUuid String?
  tomanStatus       Int?
  followUpCode      String?
  receiptLink       String?
  error             String?
  submittedAt       DateTime?
  settledAt         DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  retryOfId         String?

  batch         SettlementBatch  @relation(fields: [batchId], references: [id], onDelete: Restrict)
  store         Store?           @relation(fields: [storeId], references: [id], onDelete: Restrict)
  payments      Payment[]
  hotelBookings HotelBooking[]
  retryOf       SettlementItem?  @relation("SettlementRetries", fields: [retryOfId], references: [id], onDelete: Restrict)
  retries       SettlementItem[] @relation("SettlementRetries")

  @@unique([batchId, beneficiaryType, beneficiaryKey])
  @@index([batchId, status])
  @@index([retryOfId])
}

/// لاگ خام رویدادهای webhook هتل‌یار.
///
/// دو کار می‌کند: (۱) idempotency — هتل‌یار یک رویداد را می‌تواند چند بار
/// بفرستد و کلید یکتای زیر جلوی برگشت دوبارهٔ اعتبار را می‌گیرد،
/// (۲) بایگانی — اگر پردازش شکست بخورد بدنهٔ خام برای بررسی دستی می‌ماند.
model GdsWebhookEvent {
  id            String    @id @default(uuid())
  /// reserve | reserve_reject | change
  action        String
  /// شناسهٔ رزرو در هتل‌یار (detail.reservationId)
  reservationId String
  /// شناسهٔ تغییر برای اکشن change — برای بقیه رشتهٔ خالی تا کلید یکتا کار کند
  changeId      String    @default("")
  /// بدنهٔ خام رویداد، همان‌طور که رسیده
  payload       Json
  bookingId     String?
  /// null یعنی هنوز/هرگز پردازش نشده — با error پر می‌شود
  processedAt   DateTime?
  error         String?
  receivedAt    DateTime  @default(now())

  booking HotelBooking? @relation(fields: [bookingId], references: [id])

  @@unique([action, reservationId, changeId])
  @@index([receivedAt])
}

// ─── تراکنش ───────────────────────────────────────────────────────────────────

enum TransactionType {
  PURCHASE
  REFUND
  ADJUSTMENT
  /// واریز پرداخت درگاه به کیف پول شخصی
  TOPUP
  /// برداشت از کیف پول شخصی برای بازگشت پول به کارت
  WITHDRAWAL
}

model Transaction {
  id               String          @id @default(uuid())
  type             TransactionType @default(PURCHASE)
  /// مبلغ (تومان) — برای REFUND هم مثبت ذخیره می‌شود؛ جهت از type مشخص است
  amount           BigInt
  employeeId       String
  allocationId     String
  storeId          String?
  purchaseCodeId   String?         @unique
  /// پرداختی که این سطر بخشی از آن است (پرداخت شکسته‌شده بین چند کیف پول)
  paymentId        String?
  /// درخواست پرداخت UPG — کسرها و برگشت‌های یک خرید زیر یک intent جمع می‌شوند
  intentId         String?
  /// پرداخت درگاهی که این TOPUP را ساخته
  gatewayPaymentId String?
  /// بازگشت پول به کارت: WITHDRAWAL هنگام درخواست، و TOPUP اگر بازگشت شکست خورد
  gatewayRefundId  String?
  note             String?
  createdAt        DateTime        @default(now())

  employee       Employee         @relation(fields: [employeeId], references: [id])
  allocation     WalletAllocation @relation(fields: [allocationId], references: [id])
  store          Store?           @relation(fields: [storeId], references: [id])
  purchaseCode   PurchaseCode?    @relation(fields: [purchaseCodeId], references: [id])
  payment        Payment?         @relation(fields: [paymentId], references: [id])
  intent         PaymentIntent?   @relation(fields: [intentId], references: [id], onDelete: Restrict)
  gatewayPayment GatewayPayment?  @relation(fields: [gatewayPaymentId], references: [id], onDelete: Restrict)
  gatewayRefund  GatewayRefund?   @relation(fields: [gatewayRefundId], references: [id], onDelete: Restrict)
  hotelBooking   HotelBooking?

  @@index([employeeId, createdAt])
  @@index([storeId, createdAt])
  @@index([allocationId])
  @@index([paymentId])
  @@index([intentId])
  @@index([gatewayPaymentId])
  @@index([gatewayRefundId])
}

// ─── مدیر سامانه (داشبورد) ────────────────────────────────────────────────────

enum AdminRole {
  /// دسترسی کامل، از جمله مدیریت سایر مدیران
  SUPER_ADMIN
  /// دسترسی کامل به کارمندان، فروشگاه‌ها و کیف‌پول‌ها
  ADMIN
  /// فقط خواندن — گزارش‌ها و فهرست‌ها
  VIEWER
}

/// کاربر داشبورد مدیریت. توکن آن `role: 'admin'` دارد و نه JwtAuthGuard کارمند
/// آن را می‌پذیرد و نه StoreJwtGuard فروشگاه.
model Admin {
  id           String    @id @default(uuid())
  username     String    @unique
  name         String
  passwordHash String
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// Server-priced flight selection; short lived and owned by the employee.
model FlightQuote {
  id         String         @id @default(uuid())
  employeeId String
  search     Json
  offer      Json
  amount     BigInt
  expiresAt  DateTime
  createdAt  DateTime       @default(now())
  booking    FlightBooking?

  @@index([employeeId, expiresAt])
}

/// One reservation attempt per quote, persisted before external side effects.
model FlightBooking {
  id               String            @id @default(uuid())
  quoteId          String            @unique
  employeeId       String
  /// کیف پول رزروهای قبل از UPG — رزروهای جدید از `intentId` پرداخت می‌شوند
  allocationId     String?
  /// درخواست پرداخت UPG
  intentId         String?           @unique
  confirmationCode String?           @unique
  status           String            @default("PROCESSING")
  amount           BigInt
  refunded         Boolean           @default(false)
  tickets          Json              @default("[]")
  /// Snapshot of the submitted passengers, used for selecting a previous traveler.
  passengers       Json              @default("[]")
  bookerMobile     String?
  /// نام رزروکننده — بعد از پرداخت در UPG برای صدور بلیت لازم است
  bookerFirstName  String?
  bookerLastName   String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  quote            FlightQuote       @relation(fields: [quoteId], references: [id])
  employee         Employee          @relation(fields: [employeeId], references: [id])
  allocation       WalletAllocation? @relation(fields: [allocationId], references: [id], onDelete: Restrict)
  intent           PaymentIntent?    @relation(fields: [intentId], references: [id], onDelete: Restrict)

  @@index([employeeId, createdAt])
  @@index([status, updatedAt])
}

// ─── UPG: درگاه پرداخت یکپارچه (docs/upg.md) ─────────────────────────────────

enum PaymentIntentPurpose {
  STORE
  HOTEL
  FLIGHT
}

enum PaymentIntentStatus {
  /// منتظر انتخاب تقسیم و پرداخت از سوی کارمند
  PENDING
  /// یک پرداخت درگاه در جریان است
  AWAITING_GATEWAY
  /// پول کامل کسر شده و خرید در حال نهایی‌شدن است
  PROCESSING
  COMPLETED
  /// نهایی‌سازی خرید شکست خورد و پول کسرشده برگشت داده شد
  FAILED
  EXPIRED
  CANCELED
}

/// یک درخواست پرداخت. بخش خرید (فروشگاه، هتل، پرواز) آن را می‌سازد و UPG
/// تصمیم می‌گیرد مبلغ از اعتبار، درگاه یا هر دو تأمین شود. همهٔ کسرها و
/// برگشت‌های این خرید تراکنش‌هایی با همین `intentId` هستند.
model PaymentIntent {
  id                   String               @id @default(uuid())
  employeeId           String
  purpose              PaymentIntentPurpose
  /// شناسهٔ رکورد بخش خرید (HotelBooking / FlightBooking / Store)
  targetId             String
  title                String
  subtitle             String?
  /// مبلغ کل (تومان)
  amount               BigInt
  /// کیف‌پول‌های رفاهی که بخش خرید برای این پرداخت مجاز دانسته
  allowedAllocationIds String[]
  /// فروشگاه — روی تراکنش‌های خرید فروشگاهی نوشته می‌شود
  storeId              String?
  /// تقسیم انتخاب‌شده: [{ allocationId, amount }] — بدون سهم درگاه
  plan                 Json?
  /// سهم کارت در آخرین تقسیم (تومان)
  gatewayAmount        BigInt               @default(0)
  status               PaymentIntentStatus  @default(PENDING)
  failureReason        String?
  /// جمع مبالغ برگشت‌داده‌شده تا حالا (تومان)
  refundedAmount       BigInt               @default(0)
  /// پرداخت فروشگاهی که فروشنده با OTP آغاز کرده و کارمند باقی را با کارت می‌دهد
  merchantIntentId     String?              @unique
  expiresAt            DateTime
  completedAt          DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  employee        Employee               @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  store           Store?                 @relation(fields: [storeId], references: [id], onDelete: Restrict)
  merchantIntent  MerchantPaymentIntent? @relation(fields: [merchantIntentId], references: [id], onDelete: Restrict)
  transactions    Transaction[]
  gatewayPayments GatewayPayment[]
  payment         Payment?
  hotelBooking    HotelBooking?
  flightBooking   FlightBooking?

  @@index([employeeId, createdAt])
  @@index([status, expiresAt])
  @@index([purpose, targetId])
}

enum GatewayPaymentStatus {
  CREATED
  /// کاربر به درگاه فرستاده شد
  REDIRECTED
  /// verify موفق — مبلغ به کیف پول شخصی واریز شده
  VERIFIED
  FAILED
  EXPIRED
  /// وضعیت از درگاه قابل تعیین نیست — دستی بررسی می‌شود، خودکار تکرار نمی‌شود
  UNKNOWN
}

/// یک تلاش پرداخت در یک درگاه (تومان، جیبیت، mock). verify / استعلام / refund
/// همیشه از همان `gateway` انجام می‌شود، حتی اگر بعداً برای پرداخت تازه غیرفعال شده باشد.
model GatewayPayment {
  id              String               @id @default(uuid())
  intentId        String
  employeeId      String
  /// کلید درگاه در GatewayRegistry
  gateway         String
  /// شناسهٔ یکتای ما که به درگاه می‌رود و در callback برمی‌گردد
  trackerId       String               @unique
  /// شناسهٔ پرداخت نزد درگاه (uuid تومان)
  ref             String?
  /// مبلغ (تومان) — در مرز درگاه به ریال تبدیل می‌شود
  amount          BigInt
  status          GatewayPaymentStatus @default(CREATED)
  psp             String?
  terminal        String?
  traceNumber     String?
  referenceNumber String?
  maskedCard      String?
  /// آخرین پاسخ خام درگاه، برای بررسی دستی
  raw             Json?
  error           String?
  verifiedAt      DateTime?
  /// جمع مبالغ بازگشت به کارت (تومان) — شامل بازگشت‌های در جریان، تا دو
  /// درخواست هم‌زمان نتوانند بیش از مبلغ پرداخت برگردانند؛ بازگشت ناموفق کم می‌شود
  refundedAmount  BigInt               @default(0)
  /// آخرین استعلام cron از درگاه (پرداخت‌هایی که callback آن‌ها نرسید)
  checkedAt       DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  intent       PaymentIntent   @relation(fields: [intentId], references: [id], onDelete: Restrict)
  employee     Employee        @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  transactions Transaction[]
  refunds      GatewayRefund[]

  @@unique([gateway, ref])
  @@index([intentId])
  @@index([status, createdAt])
  @@index([employeeId, createdAt])
}

enum GatewayRefundStatus {
  /// ثبت شد ولی پاسخ درگاه هنوز نرسیده (یا گم شد) — با trackerId پیگیری می‌شود
  SUBMITTING
  /// درگاه پذیرفت و در جریان است
  PENDING
  /// درگاه خودش وضعیت را نمی‌داند (Unknown تومان) — مثل PENDING پیگیری می‌شود
  UNKNOWN
  SUCCEEDED
  /// پولی به کارت نرفت — مبلغ به ماندهٔ کیف پول شخصی برگشت
  FAILED
  /// درگاه رد کرد (مثلاً کیف پول refund ما خالی است) — مبلغ به مانده برگشت
  DENIED
}

/// بازگشت پول از کیف پول شخصی به کارت، روی یکی از پرداخت‌های درگاهی قبلی.
/// یک درخواست «بازگشت پول» کارمند ممکن است بین چند پرداخت پخش شود.
model GatewayRefund {
  id               String              @id @default(uuid())
  gatewayPaymentId String
  employeeId       String
  /// همان درگاه پرداخت — refund همیشه از درگاهی است که پول را گرفته
  gateway          String
  /// مبلغ (تومان)
  amount           BigInt
  /// شناسهٔ یکتای ما نزد درگاه — برای پیگیری وقتی پاسخ ثبت گم شده
  trackerId        String              @unique
  /// شناسهٔ بازگشت نزد درگاه (uuid تومان)
  ref              String?
  status           GatewayRefundStatus @default(SUBMITTING)
  error            String?
  raw              Json?
  checkedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  gatewayPayment GatewayPayment @relation(fields: [gatewayPaymentId], references: [id], onDelete: Restrict)
  employee       Employee       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  transactions   Transaction[]

  @@index([gatewayPaymentId])
  @@index([employeeId, createdAt])
  @@index([status, checkedAt])
}
