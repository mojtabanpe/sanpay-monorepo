generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── کارمند ───────────────────────────────────────────────────────────────────

model Employee {
  id            String   @id @default(uuid())
  /// کد ملی — شناسهٔ ورود به سامانه
  nationalCode  String   @unique
  personnelCode String   @unique
  firstName     String
  lastName      String
  phone         String?
  passwordHash  String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  allocations   WalletAllocation[]
  purchaseCodes PurchaseCode[]
  transactions  Transaction[]
  payments      Payment[]
  hotelBookings HotelBooking[]
}

// ─── کیف پول ──────────────────────────────────────────────────────────────────

enum WalletKind {
  /// اعتبار خرید عادی
  CREDIT
  /// سهمیهٔ ارزاق
  RATION
  /// اعتبار گردشگری — فقط برای رزرو هتل از طریق هتل‌یار، نه فروشگاه‌ها
  TOURISM
}

/// تعریف مشترک یک کیف پول (مثلاً «ارزاق ماهانه») که به فروشگاه‌های مشخصی وصل است.
/// اعتبار هر کارمند از این تعریف، در WalletAllocation با سقف و انقضای خودش نگهداری می‌شود.
model WalletDefinition {
  id          String     @id @default(uuid())
  name        String
  kind        WalletKind @default(CREDIT)
  description String?
  /// اسلاگ آیکون برای نمایش در اپ (food | grocery | sport | health | …)
  icon        String?
  /// سقف پیش‌فرض تخصیص‌ها (تومان) — قابل بازنویسی به‌ازای هر کارمند
  defaultCap  BigInt?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stores      WalletDefinitionStore[]
  allocations WalletAllocation[]
}

/// تخصیص یک کیف پول به یک کارمند: سقف اعتبار، مصرف‌شده و تاریخ انقضا.
/// مانده = cap - spent
model WalletAllocation {
  id           String   @id @default(uuid())
  employeeId   String
  definitionId String
  /// سقف اعتبار (تومان)
  cap          BigInt
  /// جمع مصرف‌شده (تومان) — دینرمالایز از تراکنش‌ها
  spent        BigInt   @default(0)
  expiresAt    DateTime
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee      Employee         @relation(fields: [employeeId], references: [id])
  definition    WalletDefinition @relation(fields: [definitionId], references: [id])
  purchaseCodes PurchaseCode[]
  transactions  Transaction[]
  hotelBookings HotelBooking[]

  @@index([employeeId])
  @@index([definitionId])
}

// ─── فروشگاه ──────────────────────────────────────────────────────────────────

model Store {
  id           String   @id @default(uuid())
  name         String
  /// کد کوتاه فروشگاه — محتوای QR ثابتِ چاپ‌شده روی صندوق و قابل تایپ دستی
  code         String   @unique
  /// دسته‌بندی (آجیل، میوه، پروتئین، عینک، …)
  category     String?
  phone        String?
  address      String?
  /// ورود پنل فروشگاه
  username     String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  walletDefinitions WalletDefinitionStore[]
  transactions      Transaction[]
  payments          Payment[]
}

/// رابطهٔ چند-به-چند: هر کیف پول در کدام فروشگاه‌ها قابل استفاده است
model WalletDefinitionStore {
  definitionId String
  storeId      String

  definition   WalletDefinition @relation(fields: [definitionId], references: [id])
  store        Store            @relation(fields: [storeId], references: [id])

  @@id([definitionId, storeId])
}

// ─── خرید با کد یک‌بارمصرف ────────────────────────────────────────────────────

enum PurchaseCodeStatus {
  PENDING
  USED
  EXPIRED
  CANCELED
}

/// کد QR یک‌بارمصرف که کارمند می‌سازد و فروشنده اسکن می‌کند (اعتبار ~۱ دقیقه)
model PurchaseCode {
  id           String             @id @default(uuid())
  code         String             @unique
  employeeId   String
  allocationId String
  status       PurchaseCodeStatus @default(PENDING)
  expiresAt    DateTime
  createdAt    DateTime           @default(now())

  employee    Employee         @relation(fields: [employeeId], references: [id])
  allocation  WalletAllocation @relation(fields: [allocationId], references: [id])
  transaction Transaction?

  @@index([employeeId, status])
}

// ─── پرداخت ───────────────────────────────────────────────────────────────────

/// یک پرداخت در صندوق فروشگاه: کارمند QR ثابت فروشگاه را اسکن می‌کند، مبلغ را
/// وارد می‌کند و مبلغ می‌تواند بین چند کیف پول شکسته شود. هر سطر یک Transaction است.
model Payment {
  id         String   @id @default(uuid())
  /// شمارهٔ رسید — چیزی که کارمند به فروشنده نشان می‌دهد و در پنل فروشگاه دیده می‌شود
  receiptNo  String   @unique
  employeeId String
  storeId    String
  /// جمع کل پرداخت (تومان)
  amount     BigInt
  createdAt  DateTime @default(now())

  employee     Employee      @relation(fields: [employeeId], references: [id])
  store        Store         @relation(fields: [storeId], references: [id])
  transactions Transaction[]

  @@index([storeId, createdAt])
  @@index([employeeId, createdAt])
}

// ─── رزرو هتل (گردشگری) ───────────────────────────────────────────────────────

enum BookingStatus {
  /// ظرفیت آنلاین قطعی — هتل‌یار statusCode=1 برگردانده
  CONFIRMED
  /// ظرفیت آفلاین — هتل‌یار بعداً از طریق webhook تأیید یا رد می‌کند
  PENDING
  REJECTED
  CANCELED
}

/// رزرو هتل با اعتبار گردشگری. هتل‌ها فروشگاه نیستند: رزرو مستقیماً روی API
/// هتل‌یار انجام می‌شود و فقط در صورت موفقیت، اعتبار کارمند کم می‌شود.
/// تسویهٔ ریالی با هتل‌یار جداگانه و شبانه انجام می‌شود (settledAt).
model HotelBooking {
  id           String        @id @default(uuid())
  /// شمارهٔ پیگیری داخلی — همان externalId که به هتل‌یار فرستاده می‌شود
  referenceNo  String        @unique
  /// شناسهٔ رزرو در سامانهٔ هتل‌یار (response.reserve.info.id)
  gdsReserveId String?
  status       BookingStatus @default(PENDING)

  employeeId   String
  allocationId String
  /// تراکنش کسر اعتبار — تا وقتی رزرو در هتل‌یار موفق نشده null است
  transactionId String?      @unique

  hotelId    Int
  hotelName  String
  roomId     Int
  roomType   String
  checkin    DateTime
  nights     Int
  guestName  String
  guestIdNo  String
  /// مبلغ کسرشده از کیف پول (تومان)
  amount     BigInt
  /// مبلغی که باید به هتل‌یار پرداخت شود (تومان) — مبنای تسویهٔ شبانه
  payable    BigInt

  /// زمان تسویه با هتل‌یار از طریق پرداخت‌یار (null = تسویه‌نشده)
  settledAt DateTime?
  /// شناسهٔ دستهٔ تسویهٔ شبانه
  settlementBatchId String?

  /// زمان رد/کنسل‌شدن از سمت هتل‌یار (از طریق webhook)
  canceledAt DateTime?
  /// مبلغی که بابت رد یا کنسلی به کیف پول برگشت (تومان)
  refundedAmount BigInt?
  /// توضیح هتل‌یار دربارهٔ رد یا تغییر رزرو — در اپ به کارمند نشان داده می‌شود
  statusNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee    Employee         @relation(fields: [employeeId], references: [id])
  allocation  WalletAllocation @relation(fields: [allocationId], references: [id])
  transaction Transaction?     @relation(fields: [transactionId], references: [id])
  webhookEvents GdsWebhookEvent[]

  @@index([employeeId, createdAt])
  @@index([settledAt])
  @@index([gdsReserveId])
}

/// لاگ خام رویدادهای webhook هتل‌یار.
///
/// دو کار می‌کند: (۱) idempotency — هتل‌یار یک رویداد را می‌تواند چند بار
/// بفرستد و کلید یکتای زیر جلوی برگشت دوبارهٔ اعتبار را می‌گیرد،
/// (۲) بایگانی — اگر پردازش شکست بخورد بدنهٔ خام برای بررسی دستی می‌ماند.
model GdsWebhookEvent {
  id String @id @default(uuid())
  /// reserve | reserve_reject | change
  action String
  /// شناسهٔ رزرو در هتل‌یار (detail.reservationId)
  reservationId String
  /// شناسهٔ تغییر برای اکشن change — برای بقیه رشتهٔ خالی تا کلید یکتا کار کند
  changeId String @default("")
  /// بدنهٔ خام رویداد، همان‌طور که رسیده
  payload Json
  bookingId String?
  /// null یعنی هنوز/هرگز پردازش نشده — با error پر می‌شود
  processedAt DateTime?
  error String?
  receivedAt DateTime @default(now())

  booking HotelBooking? @relation(fields: [bookingId], references: [id])

  @@unique([action, reservationId, changeId])
  @@index([receivedAt])
}

// ─── تراکنش ───────────────────────────────────────────────────────────────────

enum TransactionType {
  PURCHASE
  REFUND
  ADJUSTMENT
}

model Transaction {
  id             String          @id @default(uuid())
  type           TransactionType @default(PURCHASE)
  /// مبلغ (تومان) — برای REFUND هم مثبت ذخیره می‌شود؛ جهت از type مشخص است
  amount         BigInt
  employeeId     String
  allocationId   String
  storeId        String?
  purchaseCodeId String?         @unique
  /// پرداختی که این سطر بخشی از آن است (پرداخت شکسته‌شده بین چند کیف پول)
  paymentId      String?
  note           String?
  createdAt      DateTime        @default(now())

  employee     Employee         @relation(fields: [employeeId], references: [id])
  allocation   WalletAllocation @relation(fields: [allocationId], references: [id])
  store        Store?           @relation(fields: [storeId], references: [id])
  purchaseCode PurchaseCode?    @relation(fields: [purchaseCodeId], references: [id])
  payment      Payment?         @relation(fields: [paymentId], references: [id])
  hotelBooking HotelBooking?

  @@index([employeeId, createdAt])
  @@index([storeId, createdAt])
  @@index([allocationId])
  @@index([paymentId])
}

// ─── مدیر سامانه (داشبورد) ────────────────────────────────────────────────────

enum AdminRole {
  /// دسترسی کامل، از جمله مدیریت سایر مدیران
  SUPER_ADMIN
  /// دسترسی کامل به کارمندان، فروشگاه‌ها و کیف‌پول‌ها
  ADMIN
  /// فقط خواندن — گزارش‌ها و فهرست‌ها
  VIEWER
}

/// کاربر داشبورد مدیریت. توکن آن `role: 'admin'` دارد و نه JwtAuthGuard کارمند
/// آن را می‌پذیرد و نه StoreJwtGuard فروشگاه.
model Admin {
  id           String    @id @default(uuid())
  username     String    @unique
  name         String
  passwordHash String
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
