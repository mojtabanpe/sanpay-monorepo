FROM node:24-bookworm-slim AS build

ENV CI=true
WORKDIR /workspace

RUN corepack enable && corepack prepare pnpm@10.24.0 --activate

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .
RUN pnpm prisma generate \
  && pnpm nx run-many -t build -p app dashboard store api --configuration=production

FROM node:24-bookworm-slim AS api

ENV NODE_ENV=production
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@10.24.0 --activate

COPY --from=build /workspace/package.json /workspace/pnpm-lock.yaml ./
COPY --from=build /workspace/node_modules ./node_modules
COPY --from=build /workspace/dist ./dist
COPY --from=build /workspace/prisma.config.ts ./prisma.config.ts
COPY --from=build /workspace/apps/api/prisma ./apps/api/prisma

EXPOSE 6500
CMD ["sh", "-c", "pnpm exec prisma migrate deploy && node dist/apps/api/main.js"]

FROM nginx:1.29-alpine AS app
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/dist/apps/app/browser /usr/share/nginx/html

FROM nginx:1.29-alpine AS dashboard
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/dist/apps/dashboard/browser /usr/share/nginx/html

FROM nginx:1.29-alpine AS store
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/dist/apps/store/browser /usr/share/nginx/html
