# عکس پروفایل تا ۲MB آپلود می‌شود (multipart کمی بیشتر)؛ پیش‌فرض nginx یک مگابایت است
client_max_body_size 3m;

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# Rendered by the nginx image at container start (envsubst): ${EMPLOYEE_HOSTS},
# ${ADMIN_HOSTS} and ${STORE_HOSTS} come from compose.production.yml, which
# defaults them to the production names. A staging server sets its own names in
# .env.production. Only variables defined in the container are replaced, so
# nginx variables such as $host stay untouched.

# Docker can assign different IPs when frontend containers are recreated.
# Resolve service names at request time rather than keeping startup addresses.
resolver 127.0.0.11 valid=10s ipv6=off;
resolver_timeout 5s;

server {
    listen 80 default_server;
    server_name ${EMPLOYEE_HOSTS};

    location / {
        set $employee_backend app:80;
        proxy_pass http://$employee_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}

server {
    listen 80;
    server_name ${ADMIN_HOSTS};

    location / {
        set $dashboard_backend dashboard:80;
        proxy_pass http://$dashboard_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}

server {
    listen 80;
    server_name ${STORE_HOSTS};

    location / {
        set $store_backend store:80;
        proxy_pass http://$store_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}
