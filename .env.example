# نمونهٔ .env — کپی کنید به `.env` و مقادیر واقعی را بگذارید (`.env` گیت‌ایگنور است)

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sanpay?schema=public"
JWT_SECRET="یک-راز-تصادفی-بلند"
# راز جداگانه برای هش کدهای OTP (در نبود آن JWT_SECRET استفاده می‌شود)
OTP_SECRET="یک-راز-تصادفی-بلند-دیگر"
# در توسعه می‌توان console گذاشت؛ برای ارسال واقعی مقدار دیگری قرار دهید
SMS_MODE="smsir"
SMSIR_API_KEY=""
# قالب sms.ir برای لینک پرداخت باقی مبلغ خرید فروشگاهی با کارت (پارامترها: STORE، PRICE، LINK)
SMSIR_PAYMENT_LINK_TEMPLATE_ID=""

# UPG — درگاه پرداخت یکپارچه (docs/upg.md)
# آدرس عمومی اپ کارمند: callback درگاه و صفحهٔ نتیجه زیر همین دامنه‌اند
UPG_PUBLIC_URL="http://localhost:6200"
# درگاه‌های فعال برای پرداخت تازه، به ترتیب اولویت: mock، toman. خالی = فقط اعتبار.
# mock و toman در حالت شبیه‌ساز، در production خاموش‌اند مگر UPG_ALLOW_MOCK=true —
# هر پرداختی را «موفق» می‌پذیرند.
UPG_GATEWAYS="mock"
# priority (اولی + failover) یا weighted (با UPG_WEIGHTS="toman:70,jibit:30")
UPG_STRATEGY="priority"
# نتیجهٔ «بازگشت پول به کارت» در درگاه‌های آزمایشی: success | failed | denied | unknown
# UPG_MOCK_REFUND_RESULT="success"

# ─── درگاه پرداخت تومان (IPG) ────────────────────────────────────────────────
# live = ipg.toman.ir / ipg-staging.toman.ir (TomanIpgHttpClient)
# هر مقدار دیگری (یا نبودِ متغیر) = شبیه‌ساز درون‌حافظه‌ای با صفحهٔ بانک محلی
# (/api/upg/mock-toman/:uuid). حالت شبیه‌ساز با ری‌استارت API پاک می‌شود.
# بررسی: pnpm nx run api:check-toman-ipg (فقط ساخت پرداخت و استعلام؛ بدون verify)
TOMAN_IPG_MODE="mock"
# staging: https://ipg-staging.toman.ir — production: https://ipg.toman.ir
TOMAN_IPG_URL="https://ipg-staging.toman.ir"
# staging: https://auth.qbitpay.org/oauth2/token/ — production: https://accounts.qbitpay.org/oauth2/token/
TOMAN_IPG_AUTH_URL="https://auth.qbitpay.org/oauth2/token/"
# خالی = همان اعتبارنامهٔ بانکداری شرکتی (TOMAN_*). scopeها:
# payment.create، payment.list، ipg.refund.create، ipg.refund.read (و ipg.payment.reverse برای فاز ۳)
TOMAN_IPG_USERNAME=""
TOMAN_IPG_PASSWORD=""
TOMAN_IPG_CLIENT_ID=""
TOMAN_IPG_CLIENT_SECRET=""
# اختیاری — ترمینال مشخص؛ خالی = پیش‌فرض تنظیم‌شده نزد تومان
TOMAN_IPG_TERMINAL=""
TOMAN_IPG_TIMEOUT_MS="20000"
# قالب ورود 938507 در کد تنظیم شده است (CODE)
# قالب تأیید خرید 944060 در کد تنظیم شده است (CODE, STORE, PRICE, CURRENCY, WALLET)
# PORT=6500

# ─── هتل‌یار / WorldGDS ───────────────────────────────────────────────────────
# live = API واقعی (GdsHttpClient) — نیازمند سه متغیر پایین
# هر مقدار دیگری (یا نبودِ متغیر) = دادهٔ نمونهٔ محلی (GdsMockClient)
GDS_MODE="live"
# محیط دمو: https://apidemo.worldgds.com — محیط اصلی: https://api.worldgds.com
GDS_URL="https://apidemo.worldgds.com"
GDS_API_KEY=""
GDS_USERNAME=""
GDS_PASSWORD=""
# راز مسیر webhook — آدرسی که به هتل‌یار اعلام می‌کنیم:
#   https://<دامنه>/api/tourism/webhook/<همین مقدار>
# با `openssl rand -hex 32` بسازید؛ خالی یعنی اندپوینت webhook بسته است
GDS_WEBHOOK_SECRET=""

# ─── تسویهٔ شبانه با بانکداری شرکتی تومان ────────────────────────────────────
# cron فقط با true فعال می‌شود. ابتدا در mock و سپس با اطلاعات sandbox آزمایش کنید.
TOMAN_SETTLEMENTS_ENABLED="false"
TOMAN_MODE="live"
# Staging only: use sandbox credentials; keep the scheduler disabled until verified.
TOMAN_AUTH_URL="https://auth.qbitpay.org/oauth2/token/"
TOMAN_API_URL="https://dbank-staging.qcluster.org/api/v1"
TOMAN_USERNAME=""
TOMAN_PASSWORD=""
TOMAN_CLIENT_ID=""
TOMAN_CLIENT_SECRET=""
TOMAN_TIMEOUT_MS="20000"
TOMAN_HOTELYAR_IBAN=""
TOMAN_HOTELYAR_NAME="هتل‌یار"
TOMAN_EGHAMAT24_IBAN=""
TOMAN_EGHAMAT24_NAME="اقامت۲۴"

# هتل اقامت۲۴ — Client-Token کامل و بدون تغییر، حتی اگر شبیه URL است
GRS_MODE="mock"
GRS_URL="https://hotel-test-01.denv.ir"
GRS_CLIENT_TOKEN=""
# برای حفظ $ هنگام اجرای Nx می‌توان مقدار Base64 توکن را تنظیم کرد؛ رمزنگاری نیست.
GRS_CLIENT_TOKEN_BASE64=""

# پرواز اقامت۲۴ — همان GRS_CLIENT_TOKEN هتل را استفاده می‌کند (یک توکن برای هر دو).
FLIGHT_MODE="disabled"
# اصلی: https://gateway.grschannel.com/flight — تست: https://gateway-test-01.denv.ir/flight
FLIGHT_URL="https://gateway-test-01.denv.ir/flight"
# واحد مبلغ تأییدشده توسط تأمین‌کننده: IRR (ریال) یا IRT (تومان)
FLIGHT_CURRENCY="IRR"

# پوشهٔ فایل‌های آپلودی (عکس پروفایل) — در production همان volume `api_uploads`
UPLOADS_DIR="data/uploads"
