# نمونهٔ .env — کپی کنید به `.env` و مقادیر واقعی را بگذارید (`.env` گیت‌ایگنور است)

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sanpay?schema=public"
JWT_SECRET="یک-راز-تصادفی-بلند"
# راز جداگانه برای هش کدهای OTP (در نبود آن JWT_SECRET استفاده می‌شود)
OTP_SECRET="یک-راز-تصادفی-بلند-دیگر"
# در توسعه می‌توان console گذاشت؛ برای ارسال واقعی مقدار دیگری قرار دهید
SMS_MODE="smsir"
SMSIR_API_KEY=""
# شناسهٔ قالب تأیید در پنل sms.ir (پارامتر قالب باید CODE باشد)
SMSIR_OTP_TEMPLATE_ID="123456"
# PORT=6500

# ─── هتل‌یار / WorldGDS ───────────────────────────────────────────────────────
# live = API واقعی (GdsHttpClient) — نیازمند سه متغیر پایین
# هر مقدار دیگری (یا نبودِ متغیر) = دادهٔ نمونهٔ محلی (GdsMockClient)
GDS_MODE="live"
# محیط دمو: https://apidemo.worldgds.com — محیط اصلی: https://api.worldgds.com
GDS_URL="https://apidemo.worldgds.com"
GDS_API_KEY=""
GDS_USERNAME=""
GDS_PASSWORD=""
# راز مسیر webhook — آدرسی که به هتل‌یار اعلام می‌کنیم:
#   https://<دامنه>/api/tourism/webhook/<همین مقدار>
# با `openssl rand -hex 32` بسازید؛ خالی یعنی اندپوینت webhook بسته است
GDS_WEBHOOK_SECRET=""

# ─── اقامت۲۴ / GRS ───────────────────────────────────────────────────────────
# live = سرویس واقعی (GrsHttpClient) — نیازمند دو متغیر پایین
# هر مقدار دیگری (یا نبودِ متغیر) = دادهٔ نمونهٔ محلی (GrsMockClient)
GRS_MODE="mock"
# محیط تست: https://hotel-test-01.denv.ir (فقط از داخل ایران باز است)
# فقط میزبان؛ /v1 را خود کلاینت اضافه می‌کند
GRS_URL="https://hotel-test-01.denv.ir"
# هدر Client-Token — توکن تست را اقامت۲۴ در پشتیبانی بله داده است
GRS_TOKEN=""

# ─── تسویهٔ شبانه با بانکداری شرکتی تومان ────────────────────────────────────
# cron فقط با true فعال می‌شود. ابتدا در mock و سپس با اطلاعات sandbox آزمایش کنید.
TOMAN_SETTLEMENTS_ENABLED="false"
TOMAN_MODE="mock"
# production:
TOMAN_AUTH_URL="https://accounts.qbitpay.org/oauth2/token/"
TOMAN_API_URL="https://dbank.toman.ir/api/v1"
# staging:
# TOMAN_AUTH_URL="https://auth.qbitpay.org/oauth2/token/"
# TOMAN_API_URL="https://dbank-staging.qcluster.org/api/v1"
TOMAN_USERNAME=""
TOMAN_PASSWORD=""
TOMAN_CLIENT_ID=""
TOMAN_CLIENT_SECRET=""
TOMAN_TIMEOUT_MS="20000"
TOMAN_HOTELYAR_IBAN=""
TOMAN_HOTELYAR_NAME="هتل‌یار"
TOMAN_EGHAMAT24_IBAN=""
TOMAN_EGHAMAT24_NAME="اقامت۲۴"
